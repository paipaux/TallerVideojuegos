[sub_resource type="GDScript" id="GDScript_fl5rv"]
script/source = "extends CharacterBody3D

@onready var health_component: HealthComponent = $HealthComponent

@export var speed: float = 1.0 # Velocidad de movimiento del enemigo
@export var turn: float = 6.0 # que tan rapida se voltea
@export var height: float = 2.0 # altura sobre el jugador

var player: Node3D = null

func _ready() -> void:
	add_to_group(\"flying\")
	health_component.died.connect(_on_died)
	
	# se busca al jugador
	player = get_tree().get_first_node_in_group(\"jugador\")"

